# KaTrain Docker Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL password (must match your PostgreSQL setup)
POSTGRES_PASSWORD=katrain_secure_password_CHANGE_ME

# DashScope API key for LLM translation (optional, translation skipped if not set)
# IMPORTANT: Type key directly, do not copy from web pages (may introduce smart quotes)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# WeChat Native candidate configuration. Leave real payments closed until approved.
# AppID is an identifier, not AppSecret. Native does not use AppSecret.
PAYMENTS_MODE=disabled
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=
# Used only by the explicit docker-compose.wechat-pay.yml overlay.
# Set a private host directory after the deployment plan is approved.
WECHAT_PAY_SECRET_DIR=
# Secret contents go into private files; never put them in this file or Git.
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat-pay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY_PATH=/run/secrets/wechat-pay/api_v3_key
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechat-pay/wechatpay_public_key.pem
