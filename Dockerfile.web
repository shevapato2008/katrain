FROM nvcr.io/nvidia/tensorrt:24.02-py3
RUN sed -i "s|http://archive.ubuntu.com/ubuntu/|http://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g" /etc/apt/sources.list && \
    sed -i "s|http://security.ubuntu.com/ubuntu/|http://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g" /etc/apt/sources.list
RUN apt-get update && apt-get install -y build-essential curl ffmpeg git gstreamer1.0-plugins-base gstreamer1.0-plugins-good libavcodec-dev libavformat-dev libglib2.0-0 libgl1-mesa-dev libgl1-mesa-glx libgstreamer1.0-0 libmtdev1 libportmidi-dev libpulse0 libsdl2-dev libsdl2-image-dev libsdl2-mixer-dev libsdl2-ttf-dev libswscale-dev libzip-dev ocl-icd-opencl-dev opencl-headers pkg-config python3-dev python3-pip zlib1g-dev && rm -rf /var/lib/apt/lists/*

# Install Node.js for frontend build
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

# Install Python dependencies
RUN python3 -m pip install --trusted-host pypi.tuna.tsinghua.edu.cn -i https://pypi.tuna.tsinghua.edu.cn/simple --upgrade pip && \
    python3 -m pip install --trusted-host pypi.tuna.tsinghua.edu.cn -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements-web.txt -r requirements-desktop.txt

# Compile all 11 locales from authoritative PO files; do not normalize or skip es.
RUN python3 scripts/compile_gettext_catalogs.py

# Build frontend during Docker build (not at runtime)
RUN cd katrain/web/ui && npm install && npm run build && npm run build:admin

ENV PYTHONPATH=/app
EXPOSE 8001 8010
# Build identity for the admin config check (set by compose from `git rev-parse --short HEAD`).
ARG KATRAIN_BUILD_SHA=unknown
ENV KATRAIN_BUILD_SHA=${KATRAIN_BUILD_SHA}

CMD ["python3", "-m", "katrain", "--ui", "web", "--host", "0.0.0.0", "--port", "8001"]
