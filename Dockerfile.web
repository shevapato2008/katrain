FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS ui-builder

WORKDIR /src/ui
COPY katrain/web/ui/package.json katrain/web/ui/package-lock.json ./
RUN npm ci
COPY katrain/web/ui/ ./
RUN npm run build

FROM python:3.11-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS python-builder

# Build hosts in mainland China cannot reach pypi.org reliably: the index answers
# for small packages and then times out on larger ones, which pip reports as the
# misleading "from versions: none" (observed twice on UCloud 2026-08-05, on a
# different package each time). Same mirror develop's Dockerfile.web already uses.
# Hash pinning still holds — tuna serves the same artifacts, so --require-hashes
# fails loudly if it ever does not.
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

RUN python -m venv /opt/venv
COPY requirements-web-runtime.txt /tmp/requirements-web-runtime.txt
RUN /opt/venv/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements-web-runtime.txt

FROM python:3.11-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS source-pruner

COPY --from=python-builder /opt/venv /opt/venv
COPY katrain /app/katrain
RUN rm -rf \
        /app/katrain/web/ui \
        /app/katrain/web/static \
        /app/katrain/web/static-kiosk-2d && \
    find /app/katrain -type d -name __pycache__ -prune -exec rm -rf {} + && \
    find /app/katrain -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete && \
    /opt/venv/bin/python -c "from pathlib import Path; import polib; [polib.pofile(str(p)).save_as_mofile(str(p.with_suffix('.mo'))) for p in Path('/app/katrain/i18n/locales').rglob('katrain.po')]"

FROM python:3.11-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS runtime

# Same story as PIP_INDEX_URL above: deb.debian.org stalls mid-download from
# mainland China build hosts (UCloud 2026-08-05 sat on one 8MB ffmpeg dependency
# for six minutes and never finished). Point at the mirror develop's Dockerfile
# already uses. Set APT_MIRROR=deb.debian.org to build against upstream.
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
RUN for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" "$f" || true; \
    done && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl ffmpeg libglib2.0-0 libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 katrain && \
    useradd --uid 10001 --gid 10001 --create-home --home-dir /home/katrain katrain && \
    mkdir -p /home/katrain/.katrain && \
    chown -R 10001:10001 /home/katrain

WORKDIR /app
COPY --from=python-builder --chown=10001:10001 /opt/venv /opt/venv
COPY --from=source-pruner --chown=10001:10001 /app/katrain /app/katrain
COPY --from=ui-builder --chown=10001:10001 /src/static /app/katrain/web/static
RUN find /app/katrain/i18n/locales -name katrain.mo -type f | grep -q .

ENV HOME=/home/katrain \
    PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app
USER 10001:10001
EXPOSE 8001
CMD ["python3", "-m", "katrain", "--ui", "web", "--host", "0.0.0.0", "--port", "8001"]
