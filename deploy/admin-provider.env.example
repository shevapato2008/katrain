# Merge these values into the existing private owner .env; this is not a complete runtime env.
# Credentials are deliberately empty. chmod 600 the private copy; never commit it.
KATRAIN_ADMIN_USERNAME=admin:fan
KATRAIN_ADMIN_ENV=prod
# Set a newly generated >=32-character service key, distinct from player/session keys.
KATRAIN_ADMIN_SERVICE_SECRET=''
KATRAIN_ADMIN_PROVIDER_ONLY=1
# Free the legacy operator port BEFORE the console takes it. Verify this private port is free.
KATRAIN_ADMIN_HOST_PORT=18010
# Provider-only needs neither legacy password nor legacy session key.
KATRAIN_ADMIN_PASSWORD_HASH=''
KATRAIN_ADMIN_SESSION_SECRET=''
