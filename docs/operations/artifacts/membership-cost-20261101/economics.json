{
  "kind": "derived_economics_not_raw_benchmark",
  "date": "2026-11-01",
  "scope": "Computed from parent-agent provided V100 TF3 throughput summaries; no GPU/DB access by this calculation.",
  "assumptions": {
    "calendar_month_days": 30,
    "seconds_per_month": 2592000,
    "rent_yuan_per_month": 3500,
    "non_gpu_reserve_model": "20% added to fixed rental cost, not a 20%-of-revenue fee",
    "fixed_cost_with_reserve_yuan": 4200,
    "canonical_profile": "Pinned TF3 model, 500 visits, ownership and candidate result in one analysis",
    "visits_per_standard_unit": 500,
    "credits_per_standard_unit": 1,
    "credits_per_display_point": 100,
    "display_points_per_new_prepaid_yuan": 1,
    "prepaid_yuan_per_standard_unit": 0.01,
    "report_reference_moves": 250,
    "report_reference_positions": 251,
    "kappa_meaning": "Illustrative productive/saleable fraction of measured 24x30 throughput. Cost allocation assumes that fraction is actually sold and consumed; it is not an observed utilisation measurement.",
    "one_gpu": "The two engine ports share the same V100. Never sum standalone engine throughputs as if independent GPUs."
  },
  "formulas": {
    "throughput": "requests / elapsed_batch_wall_seconds",
    "Q30": "throughput * 2592000",
    "visits30": "Q30 * 500 (nominal canonical visits; actual root visits may exceed 500)",
    "capacity": "kappa * Q30",
    "unit_cost": "fixed_cost / capacity",
    "plan_allocated_cost": "term_standard_units * unit_cost",
    "allocated_gross_margin": "(price - plan_allocated_cost) / price",
    "break_even_cohort": "ceil(fixed_cost / price)",
    "monthly_units_only_capacity_cohort": "floor(capacity / term_standard_units)",
    "weekly_stress_cohort": "floor(capacity * 7 / 30 / week_standard_units)",
    "minimum_kappa_for_continuous_full_use_profit": "fixed_cost * term_standard_units / (price * Q30)"
  },
