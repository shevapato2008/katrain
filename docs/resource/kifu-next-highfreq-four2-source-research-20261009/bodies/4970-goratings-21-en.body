  align-items: stretch;
  gap: 12px;
  margin: 12px auto;
  background-color: #eee;
  padding: 1rem;
}

.banner-container > * {
  flex: 1 1 25rem;
  min-width: 16rem;
}

.banner-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.store-badge {
