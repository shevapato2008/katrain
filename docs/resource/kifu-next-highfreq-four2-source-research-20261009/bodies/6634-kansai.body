<div class="gtranslate_wrapper" style="text-align: left;"></div>
<script>
    window.gtranslateSettings = {
        default_language: "ja",
        native_language_names: true,
        languages: ["ja", "zh-CN", "zh-TW", "ko", "en", "th", "vi", "es", "de", "fr", "pt", "ru", "uk"],
        wrapper_selector: ".gtranslate_wrapper",
        alt_flags: {
            en: "usa"
        }
    };
</script>
<script src="https://cdn.gtranslate.net/widgets/latest/float.js" defer></script>
<script>
    let lastLang = "";

    // 対応する言語コードの一覧
    const targetLanguages = ["en", "zh-CN", "zh-TW", "ko", "th", "vi", "es", "de", "fr", "pt", "ru", "uk"];

    function applyCustomTranslations() {
        // --- .gt-lang-code のテキストから言語コードを取得 ---
        const langSpan = document.querySelector(".gt-lang-code");
        if (!langSpan) return;

        // trim() で前後の余分な空白を削除、toLowerCase() で小文字に統一
        const val = langSpan.textContent.trim().toLowerCase();
        let currentLang = "";

        // 取得した言語コードが対応言語に含まれているか判定
        // ※ GTranslate側の仕様で zh-CN が cn、zh-TW が tw になる場合を考慮して完全・部分一致の両方に対応
        const matchedLang = targetLanguages.find(lang => lang.toLowerCase() === val || lang.toLowerCase().endsWith("-" + val));

        if (matchedLang) {
            currentLang = matchedLang;
        } else {
            currentLang = "ja";
        }

        // 前回の言語から変わっていないなら何もしない
        if (currentLang === lastLang) return;

        lastLang = currentLang;

        // --- カスタム翻訳の適用ロジック ---
        const selector = ["[data-ja]"].concat(targetLanguages.map(lang => `[data-${lang}]`)).join(", ");
        
        document.querySelectorAll(selector).forEach(el => {
            
            // 1. 選択された言語の属性があるか確認
            let translated = el.getAttribute("data-" + currentLang);

            // 2. 選択された言語の属性がなく、それが日本語(ja)以外の場合のフォールバック処理
            if (!translated && currentLang !== "ja") {
                if (el.hasAttribute("data-en")) {
                    translated = el.getAttribute("data-en");
                } 
                else if (el.hasAttribute("data-ja")) {
                    translated = el.getAttribute("data-ja");
                }
            }

            // 3. 日本語(ja)に戻った場合、またはフォールバックすら見つからなかった場合
            if (!translated && el.hasAttribute("data-ja")) {
                translated = el.getAttribute("data-ja");
            }

            // 最終的に適用するテキストが決定したら書き換え
            if (translated) {
                el.textContent = translated;
            }
        });
    }

    // GTranslateの描画や言語切り替えのラグを考慮し、200msごとに要素を監視
    setInterval(() => {
        applyCustomTranslations();
    }, 200);
</script>
