s/95339-9f71aa9461cac946.js\",\"73100\",\"static/chunks/73100-58bd89d047332c81.js\",\"46305\",\"static/chunks/46305-95d33ec7b82f60aa.js\",\"2452\",\"static/chunks/2452-244b1c8e71ac1f65.js\",\"88316\",\"static/chunks/88316-a66fc10881449e45.js\",\"89324\",\"static/chunks/89324-c90fe6118cdbe1a2.js\",\"62730\",\"static/chunks/62730-b41572f95771bfb0.js\",\"2363\",\"static/chunks/2363-ac00082317236343.js\",\"79951\",\"static/chunks/79951-704d9b2ab858ba83.js\",\"25623\",\"static/chunks/25623-7f44af3fed9ad9c9.js\",\"42938\",\"static/chunks/app/(with-navbar)/layout-47f93532332c002f.js\"],\"NavbarContainer\"]\n3:[\"$\",\"$L11\",null,{\"children\":[\"$\",\"$L12\",null,{\"children\":[[\"$\",\"$L13\",null,{\"targetId\":\"main-content\",\"children\":\"メインコンテンツへスキップ\"}],[\"$\",\"$L14\",null,{\"metadata\":{\"title\":\"囲碁史記　第６１回　因島の神童本因坊秀策登場｜烏天狗クーロン\",\"description\":\"虎次郎誕生 しまなみ海道 　秀策は文政十二年（一八二九）五月五日、備後国御調郡三浦村大字外之浦、現在の広島県尾道市因島外浦町に生まれた。因島は、かつて毛利元就を支えた村上水軍が拠点とした瀬戸内海の島で、現在では西瀬戸自動車道（しまなみ海道）で本州および四国と結ばれている。 　父の桑原輪三は雑貨商。妻カメとの間に二男一女があり、秀策は次男である。輪三は対岸三原から入婿している。実家の安田家は代々庄屋を勤める士分に近い家柄であった。 　秀策の幼名は虎次郎。母カメは碁を知っており、胎内にあるときしばしば碁を並べていたと伝えられる。 　虎次郎が三、四歳の頃、どんなに泣いても碁石を与えるとすぐ泣\",\"ogSiteName\":\"note（ノート）\",\"ogUrl\":\"https://note.com/curon154/n/n155836d592a3\",\"ogTitle\":\"囲碁史記　第６１回　因島の神童本因坊秀策登場｜烏天狗クーロン\",\"ogDescription\":\"虎次郎誕生 しまなみ海道 　秀策は文政十二年（一八二九）五月五日、備後国御調郡三浦村大字外之浦、現在の広島県尾道市因島外浦町に生まれた。因島は、かつて毛利元就を支えた村上水軍が拠点とした瀬戸内海の島で、現在では西瀬戸自動車道（しまなみ海道）で本州および四国と結ばれている。 　父の桑原輪三は雑貨商。妻カメとの間に二男一女があり、秀策は次男である。輪三は対岸三原から入婿している。実家の安田家は代々庄屋を勤める士分に近い家柄であった。 　秀策の幼名は虎次郎。母カメは碁を知っており、胎内にあるときしばしば碁を並べていたと伝えられる。 　虎次郎が三、四歳の頃、どんなに泣いても碁石を与えるとすぐ泣\",\"ogImage\":\"https://assets.st-note.com/production/uploads/images/133368847/rectangle_large_type_2_01faadfcc86ff824de97734d716d771e.jpeg?fit=bounds\u0026quality=85\u0026width=1280\",\"ogType\":\"article\",\"twitterSite\":\"@note_PR\",\"twitterCard\":\"summary_large_image\",\"twitterAppUrlIphone\":\"note://note/n155836d592a3\",\"twitterAppUrlGoogleplay\":\"note.mu://note/n155836d592a3\",\"rssUrl\":null,\"structuredData\":{\"@context\":\"http://schema.org\",\"@graph\":[{\"@type\":\"BlogPosting\",\"mainEntityOfPage\":\"https://note.com/curon154/n/n155836d592a3\",\"headline\":\"囲碁史記　第６１回　因島の神童本因坊秀策登場\",\"keywords\":\"囲碁,因島,秀策\",\"datePublished\":\"2024-03-09T13:48:10.000+09:00\",\"dateModified\":\"2024-03-09T13:48:10.000+09:00\",\"author\":{\"@type\":\"Person\",\"name\":\"烏天狗クーロン\",\"url\":\"https://note.com/curon154\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"note（ノート）\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://assets.st-note.com/poc-image/manual/production/logo_202212.png\",\"width\":\"216\",\"height\":\"55\"}},\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://assets.st-note.com/production/uploads/images/133368847/rectangle_large_type_2_01faadfcc86ff824de97734d716d771e.jpeg\",\"width\":1280,\"height\":670},\"description\":\"虎次郎誕生 しまなみ海道 　秀策は文政十二年（一八二九）五月五日、備後国御調郡三浦村大字外之浦、現在の広島県尾道市因島外浦町に生まれた。因島は、かつて毛利元就を支えた村上水軍が拠点とした瀬戸内海の島で、現在では西瀬戸自動車道（しまなみ海道）で本州および四国と結ばれている。 　父の桑原輪三は雑貨商。妻カメとの間に二男一女があり、秀策は次男である。輪三は対岸三原から入婿している。実家の安田家は代々庄屋を勤める士分に近い家柄であった。 　秀策の幼名は虎次郎。母カメは碁を知っており、胎内にあるときしばしば碁を並べていたと伝えられる。 　虎次郎が三、四歳の頃、どんなに泣いても碁石を与えるとすぐ泣\",\"isAccessibleForFree\":false,\"hasPart\":{\"@type\":\"WebPageElement\",\"isAccessibleForFree\":false,\"cssSelector\":\".note-paywall\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@id\":\"https://note.com\",\"name\":\"トップ\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@id\":\"https://note.com/topic/games\",\"name\":\"ゲーム\"}},{\"@type\":\"ListItem\",\"position\":3,\"item\":{\"@id\":\"https://note.com/topic/games/games\",\"name\":\"ゲーム\"}},{\"@type\":\"ListItem\",\"position\":4,\"item\":{\"@id\":\"https://note.com/curon154/n/n155836d592a3\",\"name\":\"囲碁史記　第６１回　因島の神童本因坊秀策登場\"}}]},{\"@context\":\"https://schema.org/\",\"@type\":\"ImageObject\",\"contentUrl\":\"https://assets.st-note.com/img/1709945665582-GtednH6dxJ.jpg\",\"creator\":{\"@t