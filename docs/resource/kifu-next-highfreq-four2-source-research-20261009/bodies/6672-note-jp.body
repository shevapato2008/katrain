e\":\"text-text-secondary text-xs hover:text-text-primary\",\"children\":\"特商法表記\"}]}],[\"$\",\"li\",\"11\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://note.com/terms/investment_disclaimer\",\"rel\":\"$undefined\",\"target\":\"$undefined\",\"className\":\"text-text-secondary text-xs hover:text-text-primary\",\"children\":\"投資情報の免責事項\"}]}]]}]}]\na:null\nf:[[\"$\",\"title\",\"0\",{\"children\":\"囲碁史記　第６１回　因島の神童本因坊秀策登場｜烏天狗クーロン\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"虎次郎誕生 しまなみ海道 　秀策は文政十二年（一八二九）五月五日、備後国御調郡三浦村大字外之浦、現在の広島県尾道市因島外浦町に生まれた。因島は、かつて毛利元就を支えた村上水軍が拠点とした瀬戸内海の島で、現在では西瀬戸自動車道（しまなみ海道）で本州および四国と結ばれている。 　父の桑原輪三は雑貨商。妻カメとの間に二男一女があり、秀策は次男である。輪三は対岸三原から入婿している。実家の安田家は代々庄屋を勤める士分に近い家柄であった。 　秀策の幼名は虎次郎。母カメは碁を知っており、胎内にあるときしばしば碁を並べていたと伝えられる。 　虎次郎が三、四歳の頃、どんなに泣いても碁石を与えるとすぐ泣\"}],[\"$\",\"meta\",\"2\",{\"name\":\"robots\",\"content\":\"max-image-preview:large\"}],[\"$\",\"meta\",\"3\",{\"name\":\"fb:app_id\",\"content\":\"665869046808089\"}],[\"$\",\"meta\",\"4\",{\"name\":\"thumbnail\",\"content\":\"https://assets.st-note.com/production/uploads/images/133368847/rectangle_large_type_2_01faadfcc86ff824de97734d716d771e.jpeg?fit=bounds\u0026quality=85\u0026width=1280\"}],[\"$\",\"meta\",\"5\",{\"name\":\"twitter:url\",\"content\":\"https://note.com/curon154/n/n155836d592a3\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:app:id:iphone\",\"content\":\"906581110\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:app:name:iphone\",\"content\":\"note（ノート）\"}],[\"$\",\"meta\",\"8\",{\"name\":\"twitter:app:url:iphone\",\"content\":\"note://note/n155836d592a3\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:app:id:googleplay\",\"content\":\"mu.note\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:app:name:googleplay\",\"content\":\"note（ノート）\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:app:url:googleplay\",\"content\":\"note.mu://note/n155836d592a3\"}],[\"$\",\"link\",\"12\",{\"rel\":\"canonical\",\"href\":\"https://note.com/curon154/n/n155836d592a3\"}],[\"$\",\"link\",\"13\",{\"rel\":\"alternate\",\"hrefLang\":\"ja\",\"href\":\"https://note.com/curon154/n/n155836d592a3\"}],[\"$\",\"link\",\"14\",{\"rel\":\"alternate\",\"hrefLang\":\"x-default\",\"href\":\"https://note.com/curon154/n/n155836d592a3\"}],[\"$\",\"link\",\"15\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://note.com/curon154/n/n155836d592a3?hl=en\"}],[\"$\",\"meta\",\"16\",{\"name\":\"apple-itunes-app\",\"content\":\"app-id=906581110\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:title\",\"content\":\"囲碁史記　第６１回　因島の神童本因坊秀策登場｜烏天狗クーロン\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:description\",\"content\":\"虎次郎誕生 しまなみ海道 　秀策は文政十二年（一八二九）五月五日、備後国御調郡三浦村大字外之浦、現在の広島県尾道市因島外浦町に生まれた。因島は、かつて毛利元就を支えた村上水軍が拠点とした瀬戸内海の島で、現在では西瀬戸自動車道（しまなみ海道）で本州および四国と結ばれている。 　父の桑原輪三は雑貨商。妻カメとの間に二男一女があり、秀策は次男である。輪三は対岸三原から入婿している。実家の安田家は代々庄屋を勤める士分に近い家柄であった。 　秀策の幼名は虎次郎。母カメは碁を知っており、胎内にあるときしばしば碁を並べていたと伝えられる。 　虎次郎が三、四歳の頃、どんなに泣いても碁石を与えるとすぐ泣\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:url\",\"content\":\"https://note.com/curon154/n/n155836d592a3\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:site_name\",\"content\":\"note（ノート）\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:image\",\"content\":\"https://assets.st-note.com/production/uploads/images/133368847/rectangle_large_type_2_01faadfcc86ff824de97734d716d771e.jpeg?fit=bounds\u0026quality=85\u0026width=1280\"}],[\"$\",\"meta\",\"22\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:site\",\"content\":\"@note_PR\"}],[\"$\",\"meta\",\"25\",{\"name\":\"twitter:title\",\"content\":\"囲碁史記　第６１回　因島の神童本因坊秀策登場｜烏天狗クーロン\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:description\",\"content\":\"虎次郎誕生 しまなみ海道 　秀策は文政十二年（一八二九）五月五日、備後国御調郡三浦村大字外之浦、現在の広島県尾道市因島外浦町に生まれた。因島は、かつて毛利元就を支えた村上水軍が拠点とした瀬戸内海の島で、現在では西瀬戸自動車道（しまなみ海道）で本州および四国と結ばれている。 　父の桑原輪三は雑貨商。妻カメとの間に二男一女があり、秀策は次男である。輪三は対岸三原から入婿している。実家の安田家は代々庄屋を勤める士分に近い家柄であった。 　秀策の幼名は虎次郎。母カメは碁を知っており、胎内にあ