lt border-b py-2 text-sm text-text-secondary last-of-type:border-none hover:text-text-primary !my-0\",\"children\":[\"$\",\"a\",null,{\"className\":\"!no-underline\",\"href\":\"#24914fa9-2270-4047-b3ac-8ee72a8b277d\",\"id\":\"toc_item_24914fa9-2270-4047-b3ac-8ee72a8b277d\",\"children\":\"宝泉寺での修行\"}]}],[\"$\",\"li\",\"3308b14c-3c29-4a4e-9815-252a29575f68\",{\"className\":\"border-border-default border-b py-2 text-sm text-text-secondary last-of-type:border-none hover:text-text-primary !my-0\",\"children\":[\"$\",\"a\",null,{\"className\":\"!no-underline\",\"href\":\"#3308b14c-3c29-4a4e-9815-252a29575f68\",\"id\":\"toc_item_3308b14c-3c29-4a4e-9815-252a29575f68\",\"children\":\"本因坊門へ入門、そして入段\"}]}]]}]]}]}]}],[\"$\",\"h2\",\"1\",{\"name\":\"407ab14f-a5e3-4d85-8d0a-43d2a8e4e07e\",\"id\":\"407ab14f-a5e3-4d85-8d0a-43d2a8e4e07e\",\"children\":\"虎次郎誕生\"}],[\"$\",\"figure\",\"2\",{\"name\":\"983fabdd-4a37-4a22-9cb1-894793b78041\",\"id\":\"983fabdd-4a37-4a22-9cb1-894793b78041\",\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"https://assets.st-note.com/img/1709945665582-GtednH6dxJ.jpg?width=4000\u0026height=4000\u0026fit=bounds\u0026format=jpg\u0026quality=90\",\"target\":\"_blank\",\"rel\":\"noopener\",\"data-lightbox\":\"\",\"children\":[\"$\",\"$L6c\",null,{\"src\":\"https://assets.st-note.com/img/1709945665582-GtednH6dxJ.jpg?width=1200\",\"alt\":\"画像\",\"width\":620,\"height\":465,\"style\":\"$undefined\",\"data-modal\":\"true\"}]}],[\"$\",\"figcaption\",\"1\",{\"children\":\"しまなみ海道\"}]]}],[\"$\",\"p\",\"3\",{\"name\":\"773d8900-097a-46a5-a127-b1d72cccc4f0\",\"id\":\"773d8900-097a-46a5-a127-b1d72cccc4f0\",\"children\":[\"　秀策は文政十二年（一八二九）五月五日、備後国御調郡三浦村大字外之浦、現在の広島県尾道市因島外浦町に生まれた。因島は、かつて毛利元就を支えた村上水軍が拠点とした瀬戸内海の島で、現在では西瀬戸自動車道（しまなみ海道）で本州および四国と結ばれている。\",[\"$\",\"br\",\"1\",{\"children\":\"$undefined\"}],\"　父の桑原輪三は雑貨商。妻カメとの間に二男一女があり、秀策は次男である。輪三は対岸三原から入婿している。実家の安田家は代々庄屋を勤める士分に近い家柄であった。\",[\"$\",\"br\",\"3\",{\"children\":\"$undefined\"}],\"　秀策の幼名は虎次郎。母カメは碁を知っており、胎内にあるときしばしば碁を並べていたと伝えられる。\",\"$L6d\",\"　虎次郎が三、四歳の頃、どんなに泣いても碁石を与えるとすぐ泣き止んだといわれ、父に叱られ押入れに入れた時に、泣声が聞こえなり心配した家族が覗いて見ると、しまっていた碁盤に碁石を並べて遊んでいたという。母が碁を教えたのは五歳のときだった。\"]}],\"$L6e\",\"$L6f\",\"$L70\",\"$L71\",\"$L72\",\"$L73\",\"$L74\",\"$L75\",\"$L76\",\"$L77\",\"$L78\",\"$L79\",\"$L7a\",\"$L7b\",\"$L7c\",\"$L7d\",\"$L7e\",\"$L7f\",\"$L80\",\"$L81\",\"$L82\",\"$L83\",\"$L84\",\"$L85\",\"$L86\"]}],\"$L87\",\"$L88\",false,false,false,false,false,false,false,false,false,false,false,false,\"$L89\"]\n8a:I[95678,[\"31366\",\"static/chunks/ffb694b4-663bcb44731f4816.js\",\"2766\",\"static/chunks/e6a59ca9-8c62d35bd04d5e3c.js\",\"73683\",\"static/chunks/4760e086-0abfd5220a30f735.js\",\"88346\",\"static/chunks/88346-ae731ccdc9554406.js\",\"3771\",\"static/chunks/3771-5aa380b8d8eb2f39.js\",\"69515\",\"static/chunks/69515-a8bebd4b8ed1669d.js\",\"2609\",\"static/chunks/2609-d792e0f4cfc18056.js\",\"88839\",\"static/chunks/88839-ddbdc49bc3980017.js\",\"69212\",\"static/chunks/69212-11f977e5a824a2c0.js\",\"42453\",\"static/chunks/42453-cc4537298a5addde.js\",\"99459\",\"static/chunks/99459-a11d38c960c6411f.js\",\"24955\",\"static/chunks/24955-40e4d4dcbf3712de.js\",\"74419\",\"static/chunks/74419-fdc30d44f0016355.js\",\"97966\",\"static/chunks/97966-c2357b6758eedb18.js\",\"65859\",\"static/chunks/65859-bd75e920cf6619fb.js\",\"84815\",\"static/chunks/84815-78a3b0e2efd11acd.js\",\"61868\",\"static/chunks/61868-87647275a601e3b9.js\",\"34620\",\"static/chunks/34620-2124d63a3fa1cbd8.js\",\"84123\",\"static/chunks/84123-bd69084d219fdb7d.js\",\"7460\",\"static/chunks/7460-706bddaf5cd46fa0.js\",\"84812\",\"static/chunks/84812-26d552ea76a0bc17.js\",\"53723\",\"static/chunks/53723-5536e40ecb20fb8a.js\",\"95339\",\"static/chunks/95339-9f71aa9461cac946.js\",\"73100\",\"static/chunks/73100-58bd89d047332c81.js\",\"46305\",\"static/chunks/46305-95d33ec7b82f60aa.js\",\"77692\",\"static/chunks/77692-932a9e95508293b0.js\",\"94026\",\"static/chunks/94026-4012f6bf3f1677ff.js\",\"96674\",\"static/chunks/96674-ce649be254f48508.js\",\"20932\"