		<script type="text/javascript">
			(function () {
				var BANNER_MAX_HEIGHT = 330;
				var WRAPPER_ID = 'articleMiddleAd';
				var ENABLE_NAVER_SA = 'true' === 'true';
				var NAVER_SA_SELECTED_AD = 'naver_sa';
				var NAVER_SA_API_BASE_URL = 'https://cafe-ads-api.daum.net';
									var TEXT_AREA_HEIGHT = 46;
				
				function getWrapper() {
					return document.getElementById(WRAPPER_ID);
				}

				function setWrapperMinHeight() {
					var wrapper = getWrapper();
					if (!wrapper) return;

					var wrapperMinHeight =
							Math.ceil(wrapper.offsetWidth / 2) + TEXT_AREA_HEIGHT;

					wrapper.style.minHeight =
							Math.min(wrapperMinHeight, BANNER_MAX_HEIGHT) + 'px';
				}

				window.removeBannerWrapper = function () {
					var wrapper = getWrapper();
					if (wrapper) {
						wrapper.style.display = 'none';
					}
				};

				function runFallback(onError) {
					if (typeof onError === 'function') {
						onError();
						return;
					}

					loadAdFit();
				}

				function AdFitLoader() {
					var template =
							'<ins class="kakao_ad_area" ' +
							'style="display:none;width:100%;vertical-align:top" ' +
							'data-ad-unit="DAN-osnnQGIbT60x0YJ3" ' +
							'data-ad-media="320" ' +
							'data-ad-pubuser="1v8" ' +
							'data-ad-type="A" ' +
							'data-ad-width="320" ' +
							'data-ad-height="100" ' +
							'data-ad-onfail="removeBannerWrapper">' +
							'</ins>';

					return {
						load: function () {
							var wrapper = getWrapper();
							if (!wrapper) return;

							wrapper.innerHTML = template;
							setWrapperMinHeight();

							var script = document.createElement('script');
							script.async = true;
							script.src = '//t1.daumcdn.net/kas/static/ba.min.js';
							document.body.appendChild(script);
						}
					};
				}

				function GAMLoader(){
					var PC_AD_UNIT_PATH = '/113951510/daum_cafe/Cafe_PC_Web/CAFE_PC_Mobile_WEB_Board';
					var MO_AD_UNIT_PATH = '/113951510/daum_cafe/Cafe_Mobile_Web/CAFE_Mobile_WEB_Board';
					var PC_SLOT_ELEMENT_ID = 'div-gpt-ad-1773809178645-0';
					var MO_SLOT_ELEMENT_ID = 'div-gpt-ad-1773811487599-0';
					var sdkUrl = 'https://securepubads.g.doubleclick.net/tag/js/gpt.js';

					function loadSdk(onError) {
						window.googletag = window.googletag || { cmd: [] };

						var script = document.createElement('script');
						script.async = true;
						script.src = sdkUrl;
						script.crossOrigin = 'anonymous';
						script.onerror = function () {
							runFallback(onError);
						};

						document.head.appendChild(script);
					}

					return {
						load: function (onError) {
							var wrapper = getWrapper();
							if (!wrapper) return;

							var width = window.innerWidth;
							var isPc = width >= 1024;

							var adUnitPath = isPc ? PC_AD_UNIT_PATH : MO_AD_UNIT_PATH;
							var slotElementId = isPc ? PC_SLOT_ELEMENT_ID : MO_SLOT_ELEMENT_ID;
							var slotSizes = isPc ? [970, 250] : [300, 250];
							var slotWidth = isPc ? 970 : 300;
							var slotHeight = 250;

							wrapper.innerHTML =
									'<div id="' + slotElementId + '" style="min-width:' + slotWidth + 'px;min-height:' + slotHeight + 'px;margin:0 auto;text-align:center;"></div>';

							loadSdk(onError);

							googletag.cmd.push(function () {
								googletag.defineSlot(adUnitPath, slotSizes, slotElementId).addService(googletag.pubads());
								googletag.pubads().enableSingleRequest();

								googletag.pubads().addEventListener('slotRenderEnded', function (event) {
									if(event.slot.getSlotElementId() === slotElementId && event.isEmpty) {
										runFallback(onError);
									}
								});

								googletag.enableServices();
								googletag.display(slotElementId);

								wrapper.classList.remove('banner_wrapper');
							});
						}
					};
				}

				function NAMLoader() {
					var SDK_URL = 'https://ssl.pstatic.net/tveta/libs/glad/prod/gfp-core.js';
					var SLOT_ELEMENT_ID = 'nam_board_slot';
					var UNIT_ID = 'cafe_Board_MobileWeb-N239657548';

					function loadSdk(onError) {
						window.gladsdk = window.gladsdk || { cmd: [] };

						var script = document.createElement('script');
						script.async = true;
						script.src = SDK_URL;
						script.onerror = function () {
							runFallback(onError);
						};

						document.head.appendChild(script);
					}

					function ensureSlotElement() {
						var wrapper = getWrapper();
						if (!wrapper) return null;

						var slot = document.getElementById(SLOT_ELEMENT_ID);
						if (slot) return slot;

						wrapper.innerHTML = '<div id="' + SLOT_ELEMENT_ID + '" style="width:100%;text-align:center;"></div>';
						return document.getElementById(SLOT_ELEMENT_ID);
					}

					return {
						load: function (onError) {
							if (!UNIT_ID) {
								runFallback(onError);
								return;
							}

							var slotElement = ensureSlotElement();
							if (!slotElement) {
								runFallback(onError);
								return;
							}

							loadSdk(function () {
								runFallback(onError);
							});

							window.gladsdk.cmd.push(function () {
								window.gladsdk.addEventListener(window.gladsdk.event.ERROR, function () {
									runFallback(onError);
								});

								window.gladsdk.defineAdSlot({
									adUnitId: UNIT_ID,
									adSlotElementId: SLOT_ELEMENT_ID
								});
								window.gladsdk.displayAd(SLOT_ELEMENT_ID);
							});
						}
					};
				}

				function NaverSaLoader() {
					function escapeHtml(value) {
						return String(value || '')
								.replace(/&/g, '&amp;')
								.replace(/</g, '&lt;')
								.replace(/>/g, '&gt;')
								.replace(/"/g, '&quot;')
								.replace(/'/g, '&#39;');
					}

					function getSafeUrl(value) {
						var url = String(value || '').trim();
						return /^https?:\/\//i.test(url) ? url : '';
					}

					function getAdItemTemplate(ad) {
						if (!ad) return '';

						var clickUrl = getSafeUrl(ad.clickUrl ||
							(ad.headlineExtension && ad.headlineExtension.clickUrl) ||
							(ad.descriptionExtension && ad.descriptionExtension.clickUrl));
						var headline = ad.headline ||
								(ad.headlineExtension && ad.headlineExtension.headline) ||
								(ad.extraHeadlineExtensions && ad.extraHeadlineExtensions[0] && ad.extraHeadlineExtensions[0].headline);
						var description = ad.description ||
								(ad.descriptionExtension && ad.descriptionExtension.description) ||
								(ad.extraDescriptionExtension && ad.extraDescriptionExtension.description);

						clickUrl = escapeHtml(clickUrl);
						var adStartTag = clickUrl
							? '<a href="' + clickUrl + '" class="naver_ad_content" target="_blank" rel="noopener noreferrer">'
							: '<div class="naver_ad_content">';
						var adEndTag = clickUrl ? '</a>' : '</div>';

						var displayUrl = String(ad.displayUrl || '').replace(/^https?:\/\//, '');
						var imageUrl = getSafeUrl(ad.imageExtension && ad.imageExtension.imageUrl);
						imageUrl = imageUrl ? escapeHtml(imageUrl) : '';
						var imageTemplate = imageUrl
								? '<div class="naver_ad_profile_box_right">' +
								'<img src="' + imageUrl + '" alt="" ' +
								'onerror="this.onerror=null;this.closest(\'.naver_ad_profile_box_right\').classList.add(\'placeholder\');this.remove();">' +
								'</div>'
								: '<div class="naver_ad_profile_box_right placeholder"></div>';

						return adStartTag +
								'<div class="naver_ad_profile_box">' +
								'<div class="naver_ad_profile_box_left">' +
								'<h4 class="naver_ad_title">' + escapeHtml(headline) + '</h4>' +
								'<div class="naver_ad_description_box"><span class="naver_ad_description_text">' + escapeHtml(description) + '</span></div>' +
								'<div class="naver_ad_displayUrl"><span>' + escapeHtml(displayUrl) + '</span>' +
								(ad.medicalNo ? '<div class="naver_ad_medical_box"><div class="naver_ad_displayUrl_dot"></div><span>' + escapeHtml(ad.medicalNo) + '</span></div>' : '') +
								'<div class="naver_ad_mark_box"><span>광고</span></div>' +
								'</div>' +
								'</div>' + imageTemplate +
								'</div>' +
								adEndTag;
					}

					function render(ads) {
						var wrapper = getWrapper();
						var items = (ads || []).filter(function (ad) {
							return ad;
						}).map(function (ad) {
							return getAdItemTemplate(ad);
						}).filter(function (item) {
							return item;
						});
						var html = items.map(function (item, index) {
							return (index > 0 ? '<div class="naver_ad_divider"></div>' : '') + item;
						}).join('');
						if (!wrapper || !html) return false;

						wrapper.classList.remove('banner_wrapper');
						wrapper.classList.add('article_naver_sa_ad');
						wrapper.innerHTML = '<div class="naver_ad_content_wrapper">' + html + '</div>';
						wrapper.style.display = 'block';
						return true;
					}

					return {
						load: function () {
							jQuery.ajax({
								url: NAVER_SA_API_BASE_URL + '/api/v1/powerlink/article/mobile',
								method: 'GET',
								data: {
									pageSize: 2
								},
								dataType: 'json',
								timeout: 1000,
								success: function (res) {
									var ads = res && Array.isArray(res.ads) ? res.ads : [];
									if (ads.length === 0) {
										loadAdFit();
										return;
									}

									var rendered = render(ads);
									if (!rendered) {
										loadAdFit();
									}
								},
								error: function () {
									loadAdFit();
								}
							});
						}
					};
				}

				function loadAdFit() {
					new AdFitLoader().load();
				}

				function loadGoogleAdManager() {
					new GAMLoader().load(loadNaverAdManager);
				}

				function loadNaverAdManager() {
					new NAMLoader().load(loadAdFit);
				}

				function loadNaverSa() {
					if (!ENABLE_NAVER_SA) {
						loadAdFit();
						return;
					}

					new NaverSaLoader().load();
				}

				function loadSelectedAd(selectedAd) {
					if (ENABLE_NAVER_SA && selectedAd === NAVER_SA_SELECTED_AD) {
						loadNaverSa();
						return;
					}

					if (selectedAd === 'naver') {
						loadNaverAdManager();
						return;
					}

					if (selectedAd === 'google') {
						loadGoogleAdManager();
						return;
					}

					loadAdFit();
				}

				jQuery(function () {
					jQuery.ajax({
						url: 'https://cafe-ads-api.daum.net/api/v1/proportion/select?placement=mobileweb_board_middle_new',
						method: 'GET',
						dataType: 'json',
						timeout: 700,
						success: function (res) {
							var selectedAd = res && res.selectedAd;
							if (selectedAd === null) {
								removeBannerWrapper();
								return;
							}

							if (typeof selectedAd !== 'string') {
								loadAdFit();
								return;
							}

							loadSelectedAd(selectedAd);
						},
						error: function () {
							loadAdFit();
						}
					});
				});
			})();
		</script>
	</aside>
				
