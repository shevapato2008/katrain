</style></head><body><h1>Li Yang</h1><div id="lang-ctn"><div><a href="../../en/players/708.html"><img alt="en translation" class="flag-lang" src="/flags/en.svg" /></a><a href="../../zh/players/708.html"><img alt="zh translation" class="flag-lang" src="/flags/zh.svg" /></a><a href="../../ja/players/708.html"><img alt="ja translation" class="flag-lang" src="/flags/ja.svg" /></a><a href="../../ko/players/708.html"><img alt="ko translation" class="flag-lang" src="/flags/ko.svg" /></a></div></div><p><a href="..">메인 페이지로 돌아가기</a></p><h2>그래프</h2>
<div id='chartContainer'>
<svg id='graph' style='height:450px; width:600px'> </svg>
</div>
<script type="text/javascript">
var format = d3.time.format("%Y-%m-%d");
var format2 = d3.time.format("%Y/%m/%d");
d3.json('/players-json/data-708.json', function(data) {
nv.addGraph(function() {
var chart = nv.models.lineChart()
.x(function(d) { return format.parse(d[0]) })
.y(function(d) { return d[1] })
.margin({top:20, left: 50, right:50})
.useInteractiveGuideline(true)
.showYAxis(true)
.showXAxis(true)
.showLegend(false)
;

 chart.xAxis
.tickFormat(function(d) {
return format(new Date(d))
});
d3.select('#chartContainer svg')
.datum(data)
.call(chart);
nv.utils.windowResize(function() { chart.update() });
return chart;
});
});
</script>
