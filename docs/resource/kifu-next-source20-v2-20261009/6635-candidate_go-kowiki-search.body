{"batchcomplete":"","query":{"searchinfo":{"totalhits":15},"search":[{"ns":0,"title":"2026\ub144","pageid":69552,"size":122268,"wordcount":11254,"snippet":"\uc560\ub364\uc2a4 \ud0a4\ud504\ub85c\uc2a4\uc758 \uc81c3\ub300 \ub300\ud1b5\ub839 \uc870\uc9c0 \ubc14\uc2e4\ub9ac\uc6b0 \ubbf8\uad6d\uc758 \ubbfc\uad8c\uc6b4\ub3d9\uac00 \ud074\ub85c\ub383 \ucf5c\ube48 1\uc6d4 14\uc77c \ub300\ud55c\ubbfc\uad6d\uc758 \uc57c\uad6c\uc778 \uae40\ubbfc\uc7ac \uc911\ud654\uc778\ubbfc\uacf5\ud654\uad6d\uc758 <span class=\"searchmatch\">\ubc14\ub451</span>\uc778 \ub15c\uc6e8\uc774\ud551 \uc601\uad6d\uc758 \uc601\ud654\ubc30\uc6b0 \ub3c4\ub110\ub4dc \ub354\uae00\ub7ec\uc2a4 \ud64d\ucf69\uc758 \uc601\ud654\ubc30\uc6b0 \uc591\uc18c\ub8e1 \ub300\ud55c\ubbfc\uad6d\uc758 \ub7ed\ube44\uc778 \uc724\ud0dc\uc77c \uc6b0\ud06c\ub77c\uc774\ub098\uc758 \uc815\uce58\uc778 \uc62c\ub809\uc0b0\ub4dc\ub974 \uce74\ubc14\ub178\ud504 1\uc6d4","timestamp":"2026-10-08T11:04:55Z"},{"ns":0,"title":"\ud6c4\uc9c0\uc640\ub77c \ucf00\uc774\uc9c0","pageid":143799,"size":11583,"wordcount":1032,"snippet":"\ub9cc\ub4e4\uae30! (\ub178\ud558\ub77c \ud788\ub85c\uc2dc) 2003\ub144 \uc774\ub2c8\uc15cD Special Stage (\uc1fc\uc9c0 <span class=\"searchmatch\">\uc2e0\uace0</span>) \uc2a4\ud0c0\uc624\uc1583 Till the End of Time (\ub8e8\uc2dc\ud37c, \uac00\ube0c\ub9ac\uc5d0 \uc138\ub808\uc2a4\ud0c0) \uc11c\ubaac \ub098\uc774\ud2b83 (\ud050<span class=\"searchmatch\">\ub9c8</span>) 2004\ub144 \uc090\ub9ac\ub9ac \ubd88\uc5b4\ubd10! \uc7ac\uaddc\uc5b4 \ub0b4\uc77c\uc758 \uc810\ud504 (\uc7ac\uac70 \uc970\uc774\uce58) \ud658\uc0c1\uc218\ud638\uc804IV (\ube0c\ub79c\ub4dc)","timestamp":"2026-01-01T09:59:27Z"},{"ns":0,"title":"2014\ub144","pageid":12500,"size":91111,"wordcount":8366,"snippet":"- \uc804\ub77c\ub0a8\ub3c4 \uc5ec\uc218\uc2dc \ub099\ud3ec\ub3d9 \ub099\ud3ec\uac01 \uc6d0\uc7202\ubd80\ub450\uc5d0\uc11c \uae30\ub984 600\uc5ec\ud1a4\uc774 \uc720\ucd9c\ub418\uc5b4 \uadfc\ud574\uac00 \uc624\uc5fc\ub418\uc5c8\ub2e4. 2\uc6d4 1\uc77c - \uc870\ub958 \uc778\ud50c\ub8e8\uc5d4\uc790 \uc758\uc2ec <span class=\"searchmatch\">\uc2e0\uace0</span>\uac00 \ubd80\uc0b0\uad11\uc5ed\uc2dc\uc640 \ucda9\uccad\ubd81\ub3c4 \uc9c4\ucc9c\uad70\uc5d0\uc11c\ub3c4 \uc811\uc218\ub418\ub2e4. 2\uc6d4 2\uc77c \uc778\ub3c4\ub124\uc2dc\uc544 \uc218\ub9c8\ud2b8\ub77c\uc12c\uc5d0\uc11c \uc2dc\ub098\ubd95 \ud654\uc0b0\uc774 \ud3ed\ubc1c\ud558\uba74\uc11c 15\uba85\uc774 \uc0ac\ub9dd\ud558\uc600\ub2e4. \ud0c0\uc774","timestamp":"2026-09-26T10:25:27Z"},{"ns":0,"title":"\uc804\ub0a8\uad11\uc8fc\ud1b5\ud569\ud2b9\ubcc4\uc2dc\uc758 \uace0\ub4f1\ud559\uad50 \ubaa9\ub85d","pageid":4207756,"size":9148,"wordcount":221,"snippet":"\uc870\uc120\ub300\ud559\uad50 \ubd80\uc18d\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \uc870\uc120\ub300\ud559\uad50 \uc5ec\uc790\uace0\ub4f1\ud559\uad50 \ucc3d\ud3c9\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ucca8\ub2e8\uace0\ub4f1\ud559\uad50 \ud48d\uc554\uace0\ub4f1\ud559\uad50 \ud558\uc758\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud55c\uad6d\ub9d0\uc0b0\uc5c5\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud55c\uad6d<span class=\"searchmatch\">\ubc14\ub451</span>\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud55c\uad6d\ucc3d\uc758\uc608\uc220\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud55c\uad6d\ud56d\ub9cc\ubb3c\ub958\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud55c\ube5b\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud55c\uc601\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud55c\uc6b8\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud568\ud3c9\uace0\ub4f1\ud559\uad50\u00a0\u00b7 \ud568\ud3c9\uace8\ud504\uace0\ub4f1\ud559\uad50\u00a0\u00b7","timestamp":"2026-07-04T14:04:37Z"},{"ns":0,"title":"1984\ub144","pageid":6944,"size":63532,"wordcount":5742,"snippet":"12\uc6d4 15\uc77c- \ub3cc\uc0b0\ub300\uad50 \uac1c\ud1b5 1\uc6d4 1\uc77c \ub300\ud55c\ubbfc\uad6d\uc758 \ucd95\uad6c \uc120\uc218 \uae40\ud615\ubc94. \uc77c\ubcf8\uc758 \uac8c\uc784\uc74c\uc545 \uc791\uace1\uac00 \ud6c4\ub098\ud0a4 \ud1a0\ubaa8\uc2a4\ucf00. 1\uc6d4 2\uc77c \ub300\ud55c\ubbfc\uad6d\uc758 <span class=\"searchmatch\">\ubc14\ub451</span> \uae30\uc0ac \uae40\ub0a8\ud6c8. \uc77c\ubcf8\uc758 \uc5b8\ub860\uc778, \uc544\ub098\uc6b4\uc11c \uc640\ud0c0\ub098\ubca0 \uc0ac\uc640\ucf54. 1\uc6d4 3\uc77c \ub300\ud55c\ubbfc\uad6d\uc758 \ubc30\uc6b0 \uc774\uc644. \ub300\ud55c\ubbfc\uad6d\uc758 \ubc30\uc6b0 \ub098\uc11d\ubbfc. \ub300\ud55c\ubbfc\uad6d\uc758 \ubc30\uc6b0","timestamp":"2026-10-03T19:58:39Z"},{"ns":0,"title":"\uace0\uae38\ub3d9","pageid":1856554,"size":15094,"wordcount":1009,"snippet":"\ud560\uc544\ubc84\uc9c0\uac00 \uace0\uae38\ub3d9 \ub0c9\uc7a5\uace0 \ubb38\uc744 \uc5f4\uace0 \ud6d4\uccd0\uba39\uc73c\ub824 \ud558\uc790 \uace0\uae38\ub3d9\uc774 \uace0\ubc1c\ud558\uaca0\ub2e4\ub294 \ub9d0\uc5d0 \uc9d1\uc5b4\ub358\uc9c4\ub2e4. \uac70\uae30\ub2e4 \uace0\uae38\ub3d9\uc774 \uac15\ub3c4\ub85c <span class=\"searchmatch\">\uc2e0\uace0</span>\ud588\uc9c0\ub9cc \uc624\ud788\ub824 \uace0\uae38\ub3d9\uc774 \uc798\ubabb <span class=\"searchmatch\">\uc2e0\uace0</span>\ud558\ub294 \uaf34\uc774 \ub418\uc5c8\uace0 \ud560\uc544\ubc84\uc9c0\uc5d0\uac8c \uc815\uc2e0\uc801 \ud53c\ud574\uae4c\uc9c0 \uc785\uac8c \ub41c\ub2e4. \uc544\uae30\uacf5\ub8e1 \ub458\ub9ac \uc77c\ub2f9\ub4e4\uc740 \uc2e0\ubc1c\uc744 \ubb3c\uace0\uae30 \uc0bc\uc544 \ub09a\uc2dc\ub97c \ud558\uc5ec \uc2e0\ubc1c\ub4e4\uc744","timestamp":"2026-06-09T00:03:15Z"},{"ns":0,"title":"2025\ub144","pageid":69550,"size":123394,"wordcount":11388,"snippet":"\uc0ac\ub9dd\ud588\ub2e4. \ubbf8\uad6d\uc758 \ubc84\ud29c\ubc84 \uae30\uc5c5\uc778 VShojo\uac00 \uc804 \uba64\ubc84\uc758 \ud3ed\ub85c\ub85c \uc778\ud574 \ud3d0\uc5c5\ud588\ub2e4. \ub300\uad6c\uc18c\ubc29\uad50\uc721\ud6c8\ub828\uc13c\ud130\uac00 \uac74\ub9bd\ub418\uc5c8\ub2e4. 7\uc6d4 25\uc77c - \uae38\uc74c\uc5ed <span class=\"searchmatch\">\ubc14\ub451</span>\uae30\uc6d0 \uce7c\ubd80\ub9bc \uc0ac\uac74\uc774 \ubc1c\uc0dd\ud588\ub2e4. 7\uc6d4 28\uc77c \uae40\uac74\ud76c \ud2b9\uac80\uc774 &#039;\uba85\ud0dc\uade0 \uacf5\ucc9c\uac1c\uc785 \uc758\ud639&#039; \uc0ac\uac74\uacfc \uad00\ub828\ud574 \uc774\uc900\uc11d \uac1c\ud601\uc2e0\ub2f9 \ub300\ud45c\ub97c \ud53c\uc758\uc790\ub85c \uc785\uac74\ud558\uace0","timestamp":"2026-10-03T15:43:47Z"},{"ns":0,"title":"2008\ub144","pageid":11640,"size":65627,"wordcount":6308,"snippet":"\ucf5c\ub808\uc18c\ube0c. 9\uc6d4 23\uc77c - \ub300\ud55c\ubbfc\uad6d\uc758 \uc57c\uad6c \uc120\uc218 \ud64d\ud654\ucca0. 10\uc6d4 5\uc77c - \uc77c\ubcf8\uc758 \uc544\uc774\ub3cc \ubaa8\ub9ac\ud558\ub77c \uc6b0\ub8e8\ubbf8. 10\uc6d4 30\uc77c - \ub300\ud55c\ubbfc\uad6d\uc758 <span class=\"searchmatch\">\ubc14\ub451</span> \uae30\uc0ac \uc774\ub098\uacbd. 11\uc6d4 1\uc77c - \ub300\ud55c\ubbfc\uad6d\uc758 \ubc30\uc6b0 \ud55c\uc11c\uc9c4. 11\uc6d4 30\uc77c - \ub300\ud55c\ubbfc\uad6d\uc758 \ubc30\uc6b0 \uc1a1\uc900\ud76c. 12\uc6d4 4\uc77c \ub300\ud55c\ubbfc\uad6d\uc758 \ubc30\uc6b0 \uae40\uc9c0\uc548","timestamp":"2026-09-16T10:10:55Z"},{"ns":0,"title":"\uace0\ucfe0\ub77c\ud0a4\ud0c0\uad6c","pageid":405990,"size":21336,"wordcount":1404,"snippet":"\uc784\ud574\ubd80(\u81e8\u6d77\u90e8)\uc5d0 \ub4e4\uc5b4\uc120 \uacf5\uc7a5\ub4e4\uc740 \uae30\ud0c0\ud050\uc288 \uacf5\uc5c5\uc9c0\uc5ed\uc758 \uc77c\uac01\uc744 \uc774\ub8e8\uace0 \uc788\ub2e4. \ub610\ud55c \uad6c\uc758 \uc911\uc2ec\ubd80\uc5d0\ub294 \uae30\ud0c0\ud050\uc288\uc2dc\uc758 \uc8fc\uc694 \uad00\uad11\uc9c0\uc778 \uace0\ucfe0\ub77c\uc131\uc774 \uc788\ub2e4. <span class=\"searchmatch\">\ubc14\ub451</span>\ud310\uc2dd \uad6c\ud68d, \uc9c1\uc5c5\uc758 \uba85\uce6d\uc774 \ubd99\uc740 \ub9c8\uc744 \uc774\ub984(\uc6b0\uc624\ub9c8\uce58(\uc5b4\ubd80), \uac00\uc9c0\ub9c8\uce58(\ub300\uc7a5\uc7a5\uc774), \ubc14\uc0e4\ucfe0(\ub9d0\uc5d0 \uc9d0\uc744 \uc2e4\uc5b4 \uc6b4\uc1a1\ud558\ub294 \uc9c1\uc5c5)) \ub4f1\uc774 \uc131\uc2dc\uc758","timestamp":"2025-05-24T11:13:59Z"},{"ns":0,"title":"2018\ub144","pageid":66296,"size":138397,"wordcount":13203,"snippet":"\uc2e4\uc885\ub410\ub358 \ub300\ud55c\ubbfc\uad6d \uad6d\uc801 \uad50\ubbfc 1\uba85\uc774 \uc2dc\uc2e0\uc73c\ub85c \ubc1c\uacac\ub410\ub2e4\uace0 \uc678\uad50\ubd80\uac00 \ubc1d\ud614\ub2e4. \ub300\ud55c\ubbfc\uad6d \uc11c\uc6b8 \uc9c0\ud558\ucca0 3\ud638\uc120 \uc548\uad6d\uc5ed\uc5d0\uc11c \uacb0\ud575 \ud658\uc790\uac00 <span class=\"searchmatch\">\ud0c0</span>\uace0 \uc788\ub2e4\ub294 <span class=\"searchmatch\">\uc2e0\uace0</span>\uac00 \uc811\uc218\ub3fc \uc2b9\uac1d\ub4e4\uc774 \ucd9c\uadfc\uae38 \uc5f4\ucc28\uc5d0\uc11c \ud558\ucc28\ud558\ub294 \uc18c\ub3d9\uc774 \ubc8c\uc5b4\uc84c\ub2e4. \ud604\uc7a5\uc5d0 \ucd9c\ub3d9\ud55c \uc18c\ubc29\ub300\uc6d0\uc774 \uac80\uc0ac\ud55c \uacb0\uacfc \uc2e4\uc81c \ud65c\ub3d9\uc131 \uacb0\ud575 \ud658\uc790\uc778 \uac83\uc73c\ub85c","timestamp":"2026-08-26T04:35:11Z"},{"ns":0,"title":"\ubc15\uadfc\ud61c \uc815\ubd80","pageid":887769,"size":238961,"wordcount":20209,"snippet":"\uc9c0\uc9c0\uc138\ub825\uc778 \ubc18\uacf5-\ubcf4\uc218 \uc138\ub825\uc758 \uc785\uc7a5\uc5d0\uc11c \ubcfc \ub54c \ud3b8\uc9c0\uc758 \uba87\uba87 \ubd80\ubd84\ub4e4\uc740 \ubb38\uc81c\uac00 \ub420 \uc218\ub3c4 \uc788\ub2e4. \uad6d\uac00\ubcf4\uc548\ubc95 \uc704\ubc18 \uc5ec\ubd80\ub97c \ub5a0\ub098 \ub2f9\uad6d\uc758 \uc2b9\uc778\uc774\ub098 <span class=\"searchmatch\">\uc2e0\uace0</span> \uc5c6\uc774 \ubd81\ud55c\uc758 \ucd5c\uace0 \uc9c0\ub3c4\uc790\uc5d0\uac8c \ud3b8\uc9c0\ub97c \ubcf4\ub0b8 \uc0ac\uc2e4\uc774 \ub4a4\ub2a6\uac8c \uc54c\ub824\uc84c\ub2e4\ub294 \uc810\uc774\ub2e4. 2017\ub144 1\uc6d4 \ubc15\uadfc\ud61c \ub300\ud1b5\ub839\uc740 2008\ub144 \uad11\uc6b0\ubcd1 \uc0ac\ud0dc\uc640","timestamp":"2026-09-27T07:42:20Z"},{"ns":0,"title":"\uc7a5\uc735\ubc0d","pageid":1810386,"size":14361,"wordcount":1358,"snippet":"\uc720\uc8c4 \ud310\uacb0\uc744 \ubc1b\uc558\uc73c\uba70 \ubc94\ud589\uc744 \uc790\ubc31\ud588\ub2e4. \uadf8\ub294 2013\ub144 1\uc6d4 10\uc77c \uc0ac\ud615\uc774 \uc9d1\ud589\ub418\uc5c8\ub2e4. \uc774 \uc0ac\uac74\uc740 \uccab \ubc88\uc9f8 \uc0b4\uc778 \uc774\ud6c4 \uc7a5\uc735\ubc0d\uc5d0 \ub300\ud55c <span class=\"searchmatch\">\uc2e0\uace0</span>\uac00 \ube48\ubc88\ud588\uc74c\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ud604\uc9c0 \ub2f9\uad6d\uc774 \uc81c\ub300\ub85c \uc870\uc0ac\ud558\uc9c0 \uc54a\uc558\ub2e4\ub294 \uc810 \ub54c\ubb38\uc5d0 \uc911\uad6d \ub0b4\uc5d0\uc11c \ud070 \uc0ac\ud68c\uc801 \ud30c\uc7a5\uc744 \uc77c\uc73c\ucf30\ub2e4. \uc2e4\uc885\uc790 \uac00\uc871\ub4e4\uc740 \uc774","timestamp":"2026-09-03T12:24:05Z"},{"ns":0,"title":"2023\ub144","pageid":69530,"size":112098,"wordcount":10322,"snippet":"\ub098\ucca0 \ub300\ud55c\ubbfc\uad6d\uc758 \uc57c\uad6c\uc778 \uae40\uc601\ub355 1\uc6d4 22\uc77c - \uc774\ub780\uc758 \uc601\ud654\uac10\ub3c5 \ud638\uc138\uc778 \uc0e4\ud558\ube44 1\uc6d4 23\uc77c \uc77c\ubcf8\uc758 \uc57c\uad6c\uc120\uc218 \uac00\ub3c4\ud0c0 \ud788\ub85c\ubbf8\uc4f0 \ub300\ud55c\ubbfc\uad6d\uc758 <span class=\"searchmatch\">\ubc14\ub451</span>\uae30\uc0ac \uad8c\uac11\uc6a9 \uacfc\ud14c\ub9d0\ub77c\uc758 \uc81c47\ub300 \ub300\ud1b5\ub839 \uc54c\ubc14\ub85c \ucf5c\ub86c 1\uc6d4 24\uc77c - \ub300\ud55c\ubbfc\uad6d\uc758 \uc815\uce58\uc778 \ucc9c\uba85\uc218 1\uc6d4 25\uc77c - \ubbf8\uad6d\uc758 \uc601\ud654\ubc30\uc6b0 \uc2e0\ub514 \uc70c\ub9ac\uc5c4\uc2a4","timestamp":"2026-09-24T15:07:43Z"},{"ns":0,"title":"\ud63c\ub178\uc9c0\uc758 \ubcc0","pageid":222350,"size":286012,"wordcount":27568,"snippet":"\uba38\ubb34\ub974\uace0 \uc788\uc5c8\ub294\ub370, \uadf8\ub4e4\uc740 \ub178\ubd80\ud0c0\ub2e4\uc640 \ud568\uaed8 \ub2c8\uc870 \uace0\uc2e0\uc870\ub85c \uc62e\uaca8 \uc55e\uc758 \uc11c\uc220\uacfc \uac19\uc774 \ubd84\uc804\ud558\uc600\uc73c\ub098 \uc911\uacfc\ubd80\uc801\uc73c\ub85c \uc0ac\uc774\ud1a0 \ub3c4\uc2dc\ud558\ub8e8(\u658e\u85e4\u5229\u6cbb, <span class=\"searchmatch\">\uc2e0\uace0</span>\u65b0\u4e94)\ub97c \uc911\uc2ec\uc73c\ub85c \ud6c4\ucfe0\ud1a0\ubbf8 \ud788\ub370\uce74\uc4f0 \u30fb \uc2a4\uac00\uc57c \ub098\uac00\uc694\ub9ac \u30fb \uc774\ub178\ucf54 \ud6a8\uc2a4\ucf00(\u732a\u5b50\u5175\u52a9) \u30fb \ub2e8 \ub2e4\ub2e4\ub9c8\uc0ac(\u56e3\u5fe0\u6b63) \ub4f1\uc774 \ubd88\uc744 \ub193\uc73c\uba70 \ub9c9\uace0 \uc788\ub294","timestamp":"2026-09-10T12:15:14Z"},{"ns":0,"title":"\ud0a4\uc694\ud558\ub77c \uce74\uc57c","pageid":2712704,"size":51255,"wordcount":3826,"snippet":"1\uc6d4 17\uc77c\uc5d0 \ud655\uc778\ud568.\u00a0 \u201c\uc544\uce68\uc774 \uc628\ub2e4\u00a0: \ud6c4\uc720 \uc5ed\uc758 \ubbf8\uc18c\ub140\u00b7\ud0a4\uc694\ud558\ub77c \uce74\uc57c\uac00 \ub2e4\uc2dc \ub4f1\uc7a5 \ub538 \uc5ed\uc5d0 \u300c\uae5c\uc9dd\u300d\u201d. \u300aMANTANWEB(\ub9cc<span class=\"searchmatch\">\ud0c4</span>\uc6f9)\u300b (MANTAN). 2016\ub144 3\uc6d4 3\uc77c. 2016\ub144 3\uc6d4 9\uc77c\uc5d0 \uc6d0\ubcf8 \ubb38\uc11c\uc5d0\uc11c \ubcf4\uc874\ub41c \ubb38\uc11c. 2016\ub144 3\uc6d4 8\uc77c\uc5d0 \ud655\uc778\ud568.\u00a0","timestamp":"2026-09-04T09:49:45Z"}]}}