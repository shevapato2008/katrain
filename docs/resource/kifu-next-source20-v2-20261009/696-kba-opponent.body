<form method="post" name="f_summary">	
	<input type="hidden" name="tabMenu">
	<input type="hidden" name="news_div">
	<input type="hidden" name="news_no">
</form>

<script>
	//최근뉴스
	function viewPage_summary(news_div, news_no){
		f_summary.tabMenu.value = news_div;
		f_summary.news_div.value = news_div;
		f_summary.news_no.value = news_no;
		f_summary.action = "/news/summary_view.asp";
		f_summary.submit();
	}
	
	//사진아카이브
	function viewPage_picture(img, title, wdate){
		document.all.bicPhoto.style.display = "block";
		document.all.bicPhoto_img.src = img;
		document.all.bicPhoto_title.innerHTML = title;
		document.all.bicPhoto_wdate.innerHTML = wdate;
	}
</script>