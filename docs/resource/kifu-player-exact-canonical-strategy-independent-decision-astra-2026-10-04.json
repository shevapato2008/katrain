  "scope_rules": {
    "catalog": "Each environment resolves exact canonical uniquely; NFKC/OpenCC t2s/casefold canonical, alias and legacy cn/tw/jp names have no other owner for these three targets. Normalization is collision detection only, never write selection.",
    "date": "Real YYYY-MM-DD, equals date_sort and every DT value, not 1900-01-01, at/after the first full calendar year following official pro year, no later than 2026-10-04. Ambiguous/pro-start-year rows held.",
    "event_context": "EV and GN combined are nonempty and every value exactly equals album.event. All differing titles held, including possibly valid translations. Mixed-pair, teaching/study/training, exhibition, memorial and handicap records held by conservative scope.",
    "execution": "Fresh per-environment capture, correct current_database, exact member-set and catalog checks, table/row locking and CAS against full album preimage plus SGF SHA; recheck all held/protected records and untouched columns after dry rollback and apply. Intervening mixed11 opponent FK changes require fresh explicit preimages, never member expansion.",
    "external_conflicts": "Known official contradictions 148086/W,148087/B,65957/W held. External per-game matching is not an approval gate; no claim of full independent move matching or error-free source metadata.",
    "game_integrity": "19x19 board, at least 40 mainline moves, exact computed mainline count equals move_count, every RE equals database result; whole SGF and whole album JSON hashes fixed.",
    "identity": "Reuse independent catalog identity decision a2a444ceeb7895ab03ba7a912c823431adb30b9e84f5e73c0f2389024888d1ef and official person anchors; this is bounded identity inference for the frozen records, not proof of every original game fact.",
    "matching": "Only exact source strings 周鹤洋, 赵善津, 工藤纪夫 and NULL target-side FK, in explicit frozen [album_id,side] members.",
    "rank": "If present, target rank matches every corresponding BR/WR root value and is a simple 1-9 pro rank; no rank before official promotion year. Zhou 9-dan lower bound is 2001. Missing rank accepted as absence, not affirmative identity evidence.",
    "root_players": "All PB and PW property values are present and equal their corresponding database raw fields; same-value repeated properties permitted. No self-play by literal name, canonical/alias normalization or opponent FK.",
    "source": "album.source and every SO value equal https://19x19.com; source_path matches data/kifu-album/19x19/[0-9]+.sgf; all source-link and source-row preimages frozen.",
    "writes": "Only approved NULL black_player_id/white_player_id to the environment-specific target; no raw JSON/status, names, aliases, catalog deletion, event/date/source/result/SGF text changes."
  },
